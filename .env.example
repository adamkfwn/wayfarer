# Wayfarer environment variables. deploy.sh writes .env; copy this file only if you fill it in by hand.

# Azure subscription
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=

# Microsoft Foundry
FOUNDRY_RESOURCE_NAME=
PROJECT_NAME=wayfarer-project
FOUNDRY_ENDPOINT=
PROJECT_CONNECTION_STRING=
MODEL_DEPLOYMENT_NAME=gpt-5.4

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_INSTRUMENTATION_KEY=

# Tracing. Content capture stays off: alert content is identity data.
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Step 4 API. Tenant id and the app registration's client id or application id URI.
ENTRA_TENANT_ID=
API_AUDIENCE=
